# Create an Ethereum Sepolia app in Alchemy; paste its HTTPS RPC URL.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# Same dedicated test wallet you connect in MetaMask; 0x + 64 hex digits.
SEPOLIA_PRIVATE_KEY=0xYOUR_TEST_WALLET_PRIVATE_KEY

# PUBLIC: after deployment, paste the LandPool address printed by the script.
# The app reads both token addresses from this pool. Restart npm run dev afterward.
VITE_POOL_ADDRESS=
